<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="ChirpNet.Maui.Views.LoginPage"
             Title="ChirpNet - Login"
             BackgroundColor="{StaticResource BackgroundColor}">

    <ScrollView>
        <VerticalStackLayout Spacing="25" Padding="30,60,30,30">

            <Label Text="ChirpNet"
                   FontSize="Title"
                   HorizontalOptions="Center"
                   TextColor="{StaticResource PrimaryColor}" />

            <Label Text="Entre na sua conta"
                   FontSize="Large"
                   HorizontalOptions="Center" />

            <Entry Placeholder="Usuário"
                   Text="{Binding Username}"
                   ReturnType="Next" />

            <Entry Placeholder="Senha"
                   Text="{Binding Password}"
                   IsPassword="True"
                   ReturnType="Done" />

            <Label Text="{Binding ErrorMessage}"
                   TextColor="Red"
                   IsVisible="{Binding ErrorMessage, Converter={StaticResource IsNotEmptyConverter}}"
                   HorizontalOptions="Center" />

            <Button Text="Entrar"
                    Command="{Binding LoginCommand}"
                    IsEnabled="{Binding IsBusy, Converter={StaticResource InverseBooleanConverter}}"
                    IsBusy="{Binding IsBusy}" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
